<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fuint.repository.mapper.MtRiderMapper">

    <select id="findByUserId" resultType="com.fuint.repository.model.MtRider">
        SELECT * FROM mt_rider WHERE USER_ID = #{userId} AND STATUS = 'A'
    </select>

    <select id="findByRiderNo" resultType="com.fuint.repository.model.MtRider">
        SELECT * FROM mt_rider WHERE RIDER_NO = #{riderNo} AND STATUS = 'A'
    </select>

</mapper>
